# Copy this file to .env and fill in your values

# Paperless-ngx server URL (no trailing slash)
PAPERLESS_URL=http://your-paperless-server:8000

# API token from Paperless-ngx → Settings → API Tokens
PAPERLESS_TOKEN=your_api_token_here

# Local path to the mounted consume folder (e.g. Samba share)
CONSUME_DIR=/Volumes/consume

# Maximum PDF size in MB before a file is quarantined (default: 25)
MAXIMUM_FILE_SIZE_MB=50

# Path to the log file (relative to script directory)
LOG_FILE=logs/paperless_sync.log

# Folder where invalid/oversized/corrupt PDFs are copied for review
CHECK_DIR=check

# Folder for encrypted PDFs removed from the Paperless consume queue
PASSWORD_PROTECTED_PDFS_DIR=/Volumes/export/password_protected_pdfs
